import sqlite3
import tkinter as tk
from tkinter import ttk, messagebox

DB = "people.db"


def init_db():
    conn = sqlite3.connect(DB)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS people (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            age INTEGER,
            email TEXT
        )
    """)
    conn.commit()
    conn.close()


class PeopleApp:
    def __init__(self, root):
        self.root = root
        self.root.title("База людей")
        self.root.geometry("700x500")

        # --- Форма добавления ---
        form = ttk.LabelFrame(root, text="Добавить человека", padding=10)
        form.pack(fill="x", padx=10, pady=10)

        ttk.Label(form, text="Имя:").grid(row=0, column=0, sticky="w", padx=5, pady=5)
        self.name_entry = ttk.Entry(form, width=25)
        self.name_entry.grid(row=0, column=1, padx=5, pady=5)

        ttk.Label(form, text="Возраст:").grid(row=0, column=2, sticky="w", padx=5, pady=5)
        self.age_entry = ttk.Entry(form, width=10)
        self.age_entry.grid(row=0, column=3, padx=5, pady=5)

        ttk.Label(form, text="Email:").grid(row=1, column=0, sticky="w", padx=5, pady=5)
        self.email_entry = ttk.Entry(form, width=25)
        self.email_entry.grid(row=1, column=1, padx=5, pady=5)

        add_btn = ttk.Button(form, text="Добавить", command=self.add_person)
        add_btn.grid(row=1, column=3, padx=5, pady=5, sticky="e")

        # --- Таблица ---
        table_frame = ttk.Frame(root)
        table_frame.pack(fill="both", expand=True, padx=10, pady=10)

        columns = ("id", "name", "age", "email")
        self.tree = ttk.Treeview(table_frame, columns=columns, show="headings")
        self.tree.heading("id", text="ID")
        self.tree.heading("name", text="Имя")
        self.tree.heading("age", text="Возраст")
        self.tree.heading("email", text="Email")
        self.tree.column("id", width=50, anchor="center")
        self.tree.column("name", width=200)
        self.tree.column("age", width=80, anchor="center")
        self.tree.column("email", width=250)

        scrollbar = ttk.Scrollbar(table_frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # --- Кнопки управления ---
        btn_frame = ttk.Frame(root)
        btn_frame.pack(fill="x", padx=10, pady=(0, 10))

        ttk.Button(btn_frame, text="Обновить", command=self.load_people).pack(side="left", padx=5)
        ttk.Button(btn_frame, text="Удалить выбранного", command=self.delete_person).pack(side="left", padx=5)

        # Enter в поле имени = добавить
        self.name_entry.bind("<Return>", lambda e: self.add_person())

        self.load_people()

    def load_people(self):
        for row in self.tree.get_children():
            self.tree.delete(row)
        conn = sqlite3.connect(DB)
        rows = conn.execute("SELECT id, name, age, email FROM people ORDER BY id DESC").fetchall()
        conn.close()
        for r in rows:
            self.tree.insert("", "end", values=(r[0], r[1], r[2] or "—", r[3] or "—"))

    def add_person(self):
        name = self.name_entry.get().strip()
        age = self.age_entry.get().strip()
        email = self.email_entry.get().strip()

        if not name:
            messagebox.showwarning("Внимание", "Поле «Имя» обязательно для заполнения")
            return

        if age:
            if not age.isdigit() or not (0 <= int(age) <= 150):
                messagebox.showwarning("Внимание", "Возраст должен быть числом от 0 до 150")
                return

        conn = sqlite3.connect(DB)
        conn.execute(
            "INSERT INTO people (name, age, email) VALUES (?, ?, ?)",
            (name, int(age) if age else None, email or None),
        )
        conn.commit()
        conn.close()

        self.name_entry.delete(0, tk.END)
        self.age_entry.delete(0, tk.END)
        self.email_entry.delete(0, tk.END)
        self.name_entry.focus_set()
        self.load_people()

    def delete_person(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showinfo("Информация", "Сначала выберите запись в таблице")
            return

        person_id = self.tree.item(selected[0])["values"][0]
        name = self.tree.item(selected[0])["values"][1]

        if messagebox.askyesno("Подтверждение", f"Удалить «{name}»?"):
            conn = sqlite3.connect(DB)
            conn.execute("DELETE FROM people WHERE id = ?", (person_id,))
            conn.commit()
            conn.close()
            self.load_people()


if __name__ == "__main__":
    init_db()
    root = tk.Tk()
    app = PeopleApp(root)
    root.mainloop()
